[Unit]
Description=LibreOffice UNO listener for word2pdf fixer (port 2002)
After=network.target

[Service]
Type=simple
Environment=HOME=/root
ExecStart=/opt/libreoffice7.6/program/soffice --headless --norestore --nolockcheck -env:UserInstallation=file:///tmp/lo_uno --accept=socket,host=127.0.0.1,port=2002;urp;
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
